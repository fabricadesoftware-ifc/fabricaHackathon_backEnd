# Exporte estas variáveis no ambiente (o projeto não carrega .env sozinho).
# Nunca versione o arquivo .env.

# Chave secreta do Django (obrigatória em produção)
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# True apenas em desenvolvimento (padrão: True)
DEBUG=False

# Hosts permitidos, separados por vírgula
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens do front permitidas pelo CORS, separadas por vírgula
# (padrão: http://localhost:3000,http://localhost:5173)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Limite de requisições de usuários anônimos (padrão: 120/min)
ANON_THROTTLE_RATE=120/min
