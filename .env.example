# Exporte estas variáveis no ambiente (o projeto não carrega .env sozinho).
# Nunca versione o arquivo .env.

# Chave secreta do Django (obrigatória em produção)
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# True apenas em desenvolvimento (padrão: True)
DEBUG=False

# Hosts permitidos, separados por vírgula
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens do front permitidas pelo CORS, separadas por vírgula
# (padrão: http://localhost:3000,http://localhost:5173)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Limite de requisições de usuários anônimos (padrão: 120/min)
ANON_THROTTLE_RATE=120/min

# Imagens no Cloudinary (formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME).
# Sem esta variável as imagens ficam em media/ (apenas desenvolvimento). Valor de exemplo falso.
CLOUDINARY_URL=cloudinary://000000000000000:segredo-de-exemplo@nome-da-nuvem

# --- Produção (Fabroku) ---
# SECRET_KEY: gere uma nova (python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=troque-por-uma-chave-gerada
# DATABASE_URL: fornecida pelo serviço PostgreSQL do Fabroku (sem ela usa SQLite local)
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
# Origens HTTPS do front aceitas pelo CSRF, separadas por vírgula
# CSRF_TRUSTED_ORIGINS=https://front.exemplo.com

# Limites de tentativas por IP (padrão: login 10/min, registro 20/hora)
# LOGIN_THROTTLE_RATE=10/min
# REGISTRO_THROTTLE_RATE=20/hour
